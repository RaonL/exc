APP_ORIGIN=http://127.0.0.1:5173
# Default frontend build uses static demo login. To use actual server authentication,
# set VITE_AUTH_MODE=server in the build environment (or .env.local for local Vite).
PORT=3001
# Production: NODE_ENV=production, APP_ORIGIN=https://your-domain, persistent DATABASE_PATH.
# Optional first-start sample account seed; use a value of at least 8 characters.
DEMO_ACCOUNT_PASSWORD=replace-with-your-training-password
# Trust only a reverse proxy you control. Default false.
TRUST_PROXY=false
